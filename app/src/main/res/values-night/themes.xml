<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema Base para Modo Escuro (Soft UI WhatsApp Style) -->
    <style name="Theme.MeuCaixa" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Cores -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorSurface">@color/card_dark</item>
        <item name="colorOnSurface">@color/gray_200</item>

        <!-- Mantém o verde como primário, mas um pouco mais claro para destacar no fundo escuro -->
        <item name="colorPrimary">@color/green_primary</item>
        <item name="colorOnPrimary">@color/background_dark</item>
        <item name="colorSecondary">@color/green_primary_light</item>
        <item name="colorOnSecondary">@color/background_dark</item>

        <item name="colorOnSurfaceVariant">@color/gray_400</item>
        <item name="colorError">@color/red_pastel</item>

        <!-- Atributos Customizados -->
        <item name="fabIconColor">@color/black</item>
        <item name="editTextBackground">@drawable/edit_text_background_dark</item>
        <item name="quantityButtonBackground">@drawable/quantity_button_background_dark</item>
        <item name="appLogo">@drawable/ic_logo_app_dark</item>
        <item name="separatorColor">@color/gray_700</item>

        <!-- Barra de Status -->
        <item name="android:statusBarColor">?attr/android:colorBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
